// Vehicle types for volunteers
enum VehicleType {
  CAR         // سيارة
  MOTORCYCLE  // موتوسيكل
  BICYCLE     // دراجة
  WALKING     // مشيًا
}

// Gender enum
enum Gender {
  MALE        // ذكر
  FEMALE      // أنثى
}

enum DeliveryMethod {
  SELF_DELIVERY   // سأوصّل بنفسي - Donor will bring food to the hub
  PICKUP          // سيأتي إليّ متطوع - Volunteer will pick up from donor
}

enum DonationStatus {
  PENDING             // قيد الانتظار - Donor submitted, waiting for pickup
  ASSIGNED            // تم التعيين - Volunteer claimed to pick it up
  COLLECTED           // تم الاستلام - Volunteer collected from donor
  OUT_FOR_DELIVERY    // في الطريق - Volunteer en route to beneficiary
  COMPLETED           // تم التسليم - Delivered
  CANCELLED           // ملغي - Cancelled order
}

model Donation {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Donor Info (No Account Required)
  donorName       String         // اسم المتبرع
  donorPhone      String         // رقم الهاتف
  
  // Location (Optional for SELF_DELIVERY)
  addressText     String?        // العنوان التفصيلي - Only required for PICKUP
  zone            Zone?          // المنطقة - Only required for PICKUP
  
  // The Food
  description     String         // وصف الطعام - "5 meals, chicken and rice"
  quantity        Int            @default(1) // الكمية
  
  // Delivery Method
  deliveryMethod  DeliveryMethod @default(PICKUP) // طريقة التوصيل
  
  // Scheduling
  scheduledDate   DateTime       // تاريخ الاستلام والتوزيع - The date when donation will be collected and distributed
  
  // Logistics
  status          DonationStatus @default(PENDING)
  
  // Volunteer assignment (relation to User)
  volunteerId     String?        // معرف المتطوع
  volunteer       User?          @relation("AssignedDonations", fields: [volunteerId], references: [id])
  
  // Delivery tracking
  deliveredByName String?        // اسم المتطوع الذي قام بالتوصيل - Stored when order is completed
  
  // Beneficiary assignment
  beneficiaryId   String?        // معرف المستفيد
  beneficiary     Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  
  adminNotes      String?        // ملاحظات الإدارة - Internal notes for the Hub team
}

// User model - supports regular users, volunteers, and admins
model User {
  id            String       @id @default(cuid())
  phone         String       @unique
  password      String       // Hashed
  name          String
  role          String       @default("USER") // USER, PENDING_VOLUNTEER, VOLUNTEER, ADMIN
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Volunteer-specific fields (optional in DB, mandatory for volunteer registration)
  nationalId    String?      @unique  // رقم البطاقة القومية
  vehicleType   VehicleType? // نوع المركبة
  addressText   String?      // العنوان التفصيلي
  zone          Zone?        // المنطقة
  gender        Gender?      // النوع
  dateOfBirth   DateTime?    // تاريخ الميلاد
  
  // Relations
  assignedDonations Donation[] @relation("AssignedDonations")
  helpRequests      HelpRequest[] @relation("RequestedHelp")
  helpOffered       HelpRequest[] @relation("OfferedHelp")
}

// Blocked phones - prevent fake/spam donations
model BlockedPhone {
  id        String   @id @default(cuid())
  phone     String   @unique  // رقم الهاتف المحظور
  reason    String?  // سبب الحظر
  blockedBy String   // اسم الأدمن الذي حظر الرقم
  createdAt DateTime @default(now())
}

// Help Request Status
enum HelpRequestStatus {
  PENDING   // في انتظار المساعدة
  ACCEPTED  // تم قبول المساعدة
  RESOLVED  // تم حل المشكلة
  CANCELLED // تم الإلغاء
}

// Help Request - for volunteers to request help from other volunteers
model HelpRequest {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  // Who needs help
  requesterId String
  requester   User              @relation("RequestedHelp", fields: [requesterId], references: [id])
  
  // Request details
  reason      String            // سبب طلب المساعدة
  location    String            // الموقع/العنوان الحالي
  
  // Status
  status      HelpRequestStatus @default(PENDING)
  
  // Who accepted to help (optional until someone accepts)
  helperId    String?
  helper      User?             @relation("OfferedHelp", fields: [helperId], references: [id])
  
  // Optional: which donation they were working on
  donationId  String?
}

// System Settings - Admin controlled settings
model SystemSettings {
  id                String   @id @default("main") // Single row with fixed ID
  volunteerDashOpen Boolean  @default(false)      // هل لوحة المتطوعين مفتوحة؟
  updatedAt         DateTime @updatedAt
  updatedBy         String?                       // Who last updated
}

// Beneficiary - المستفيدين (الفقراء)
model Beneficiary {
  id            String     @id @default(cuid())
  name          String     // اسم المستفيد
  phone         String     // رقم الهاتف
  zone          String     // المنطقة
  address       String     // العنوان
  familyMembers Int        @default(1) // عدد أفراد الأسرة
  isActive      Boolean    @default(true) // نشط أم لا
  createdAt     DateTime   @default(now())
  
  // Relations
  donations     Donation[] // التبرعات المستلمة
}
